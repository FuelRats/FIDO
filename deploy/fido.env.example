# FIDO environment file. Names only; see README.md for defaults and meaning.
# Empty or unset values take the default. Single-quote every value. Keep the file at mode 0600.
#
# Production values (mozzarella), non-secret ones only:
#   FIDO_IRC_SERVER irc.de.fuelrats.com, which compose.yml maps to 127.0.0.1; the ircd's
#     certificate covers *.de.fuelrats.com
#   FIDO_TLS_VERIFY on
#   FIDO_EXPECT_SNOMASK +bcdfkoqsBCOS
#   FIDO_SASL_USERNAME FIDO[BOT]
#   AWS_DEFAULT_REGION eu-central-1
# FIDO_DB_URL is set by compose.yml. The oper pair, the SASL password and the AWS key pair are
# secrets: they exist only in the server's copy of this file.
FIDO_IRC_SERVER=
FIDO_IRC_PORT=
FIDO_IRC_TLS=
FIDO_TLS_VERIFY=
FIDO_TLS_SERVERNAME=
FIDO_NICK=
FIDO_OPER_NAME=
FIDO_OPER_PASSWORD=
FIDO_SASL_USERNAME=
FIDO_SASL_PASSWORD=
FIDO_EXPECT_SNOMASK=
FIDO_DB_URL=
FIDO_LOG_LEVEL=
FIDO_SESSION_RETENTION_DAYS=
FIDO_STARTUP_DEADLINE=
FIDO_SILENCE_LIMIT=
# Read by boto3 for !smssend and the ops alert SMS (modules/sms.py). The SNS client is created
# for eu-central-1 in the code, so AWS_DEFAULT_REGION does not change where SMS go.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
